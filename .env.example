# plateau-creative-mcp configuration — copy to .env (all values optional; defaults shown).

# --- Artifact data source ---------------------------------------------------
# Local cache / artifact directory holding out_<city>/buildings.parquet.
# Defaults to a cache dir (where download_area writes); point it at an existing
# plateau-bridge checkout to use locally-built outputs instead.
# PLATEAU_ARTIFACT_DIR=~/.cache/plateau-creative-mcp/artifacts

# Cache index (JSON) listing each city's prebuilt bundle URL + sha256.
# Defaults to the public plateau-bridge mirror; override for your own mirror.
# PLATEAU_ARTIFACT_INDEX_URL=https://raw.githubusercontent.com/pixelx-jp/plateau-bridge/main/distribution/index.json

# Per-download timeout in milliseconds (5000–1800000).
# PLATEAU_ARTIFACT_DOWNLOAD_TIMEOUT_MS=300000

# When "true", load_area auto-fetches a missing city from the index before loading.
# PLATEAU_AUTO_DOWNLOAD=false

# --- Output -----------------------------------------------------------------
# Where .glb / LICENSE.txt / manifests are written.
# PLATEAU_OUTPUT_DIR=./out

# --- Data access mode -------------------------------------------------------
# "artifact" (TS + duckdb) or "subprocess" (Python helper).
# PLATEAU_DATA_MODE=artifact
# PLATEAU_PYTHON_BIN=python3
# PLATEAU_SUBPROCESS_SCRIPT=   # default: bundled python/plateau_query.py

# --- Scene store ------------------------------------------------------------
# PLATEAU_SCENE_DIR=./.scene-store
# PLATEAU_PERSIST_SCENES=false
# PLATEAU_MAX_SCENES=64
# PLATEAU_SCENE_TTL_MS=3600000

# --- Upstream official PLATEAU MCP (proxied tools) --------------------------
# When "true" (or OFFICIAL_PLATEAU_MCP_URL is set), registers the 13 plateau_* tools.
# PLATEAU_UPSTREAM_ENABLED=false
# OFFICIAL_PLATEAU_MCP_URL=

# --- OSM POI linking --------------------------------------------------------
# Set OSM_OVERPASS_URL to enable link_buildings_to_pois.
# OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
# OSM_OVERPASS_TIMEOUT_MS=25000
